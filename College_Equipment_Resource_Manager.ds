				"New Formatting2"
				{
				condition = (return_status == "Not Issued")
				fields = [return_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (return_status == "Returned")
				fields = [return_status]
