				condition_at_return as "Condition at Return"
				issued_by as "Issued By"
				returned_to as "Returned To"
				return_status as "Return Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (return_status == "Damaged")
				fields = [return_status]
				format = "color:#ffffff;background-color:#765f89;"
