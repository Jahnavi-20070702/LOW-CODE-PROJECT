		list equipment_issue_return_Report
		{
			displayName = "Equipment Issue Return Report"
			show all rows from equipment_issue_return    
			(
				transaction_id as "Transaction ID"
				borrow_request as "Borrow Request"
				equipment as "Equipment"
				borrower as "Borrower"
