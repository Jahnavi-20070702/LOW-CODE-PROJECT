 application "College Equipment Resource Manager"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form borrow_request
		{
			displayname = "Borrow Request"
			success message = "Borrow Request Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			request_id
			(
    			type = text
				displayname = "Request ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			requesting_department
			(
				type = picklist	
				displayname = "Requesting Department"
				values  = department_registration.ID
    			displayformat = [department_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			requester_name
			(
    			type = text
				displayname = "Requester Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			requester_email
			(
    			type = email
				displayname = "Requester Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			purpose
			(
    			type = textarea
				displayname = "Purpose"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			required_from
			(
    			type = datetime
				displayname = "Required From"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			required_until
			(
    			type = datetime
				displayname = "Required Until"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			priority
			(
				type = picklist
				displayname = "Priority"
				values = {"High","Urgent","Low","Normal"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			request_status
			(
				type = picklist
				displayname = "Request Status"
				values = {"Approved","Completed","Rejected","Cancelled","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			additional_notes
			(
    			type = textarea
				displayname = "Additional Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Request Drafted","Request Submitted","Pending Department Approval","Pending Lab Manager Approval","Equipment Reserved","Equipment Issued","Equipment In Use","Pending Return","Equipment Damaged","Equipment Lost","Equipment Returned","Inspection Pending","Request Closed"}
			}
		}
