		workflow
		{
		form
		{
			validate_borrow_dates as "Validate Borrow Request Dates"
			{
				type =  form
				form = borrow_request

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validate that required_until date is not before required_from date
										if(input.required_until != null && input.required_from != null)
										{
											if(input.required_until < input.required_from)
											{
												alert(required_until,"The return date (required_until) cannot be before the start date (required_from). Please correct the dates.");
												cancel submit;
											}
										}
						)
					}
				}

			}
			notify_manager_high_priority as "Notify Manager on High Priority Request"
			{
				type =  form
				form = borrow_request

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the current borrow request record
										borrowRequest = borrow_request[ID == input.ID];
										// Check if the request priority is Urgent
										if(borrowRequest.priority == "Urgent")
										{
											// Get the requesting department details
											departmentRecord = department_registration[ID == borrowRequest.requesting_department.ID];
											// Get the department head email
											departmentHeadEmail = departmentRecord.contact_email;
											// Prepare notification message
											notificationMessage = "<p>Dear Manager,</p>" + "<p>An urgent equipment request has been submitted.</p>" + "<p><strong>Request ID:</strong> " + borrowRequest.request_id + "</p>" + "<p><strong>Requester:</strong> " + borrowRequest.requester_name + "</p>" + "<p><strong>Department:</strong> " + departmentRecord.department_name + "</p>" + "<p><strong>Purpose:</strong> " + borrowRequest.purpose + "</p>" + "<p><strong>Required From:</strong> " + borrowRequest.required_from.toString() + "</p>" + "<p><strong>Required Until:</strong> " + borrowRequest.required_until.toString() + "</p>" + "<p>Please review and approve this request at your earliest convenience.</p>";
											// Send notification email to department head
											sendmail
											[
												from :zoho.loginuserid
												to :departmentHeadEmail
												subject :"Urgent Equipment Request Notification - " + borrowRequest.request_id
												message :notificationMessage
												content type :HTML
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			warranty_expiry_reminder as "Warranty Expiry Reminder"
			{
				type =  schedule
				form = equipment_registration
					status = inactive
				start = warranty_expiry at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch equipment records where warranty expires within the next 30 days
										warrantyExpiringRecords = equipment_registration[warranty_expiry in next 30 days];
										// Iterate through each record and send email to department head
										for each  equipment in warrantyExpiringRecords
										{
											// Get the department record using the lookup field
											departmentRecord = department_registration[ID == equipment.department.ID];
											// Check if department head email is available
											if(departmentRecord.department_head.isNull() == false)
											{
												// Send email to department head
												sendmail
												[
													from :zoho.loginuserid
													to :departmentRecord.department_head
													subject :"Warranty Expiry Alert: " + equipment.equipment_name
													message :"Dear Department Head,\n\nThis is to inform you that the warranty for the following equipment will expire in 30 days.\n\nEquipment Name: " + equipment.equipment_name + "\nEquipment ID: " + equipment.equipment_id + "\nWarranty Expiry Date: " + equipment.warranty_expiry.toString() + "\n\nPlease take necessary action to renew the warranty or replace the equipment.\n\nRegards,\nEquipment Management Team"
												]
											}
										}
					)
					}
				}
			}
		}


